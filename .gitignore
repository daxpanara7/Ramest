# typescript
next-env.d.ts
# Incremental compiler cache — rewritten by every build, so tracking it meant
# an unrelated 240KB diff in commits that only touched a stylesheet.
*.tsbuildinfo

# backend secrets & build
backend/.env
backend/node_modules/
backend/dist/

# Original client photos — converted into public/assets/clients/*.webp.
# Kept out of git and out of public/ so 77MB never ships to Vercel.
assets-src/
